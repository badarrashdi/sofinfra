# Headless WordPress CMS Endpoint Configuration
#
# For Local Development (LocalWP):
NEXT_PUBLIC_WORDPRESS_URL=http://sofinfra.local
WORDPRESS_URL=http://sofinfra.local

# For Staging / Production Deployment:
# When deploying to Vercel, Netlify, or your cloud host, set this environment variable
# to your live WordPress domain:
# NEXT_PUBLIC_WORDPRESS_URL=https://cms.sofinfra.com
# WORDPRESS_URL=https://cms.sofinfra.com
