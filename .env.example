# Headless WordPress CMS Endpoint Configuration
#
# For Local Development (LocalWP):
NEXT_PUBLIC_WORDPRESS_URL=http://sofinfra.local
WORDPRESS_URL=http://sofinfra.local

# For Production Deployment:
NEXT_PUBLIC_WORDPRESS_URL=https://admin.sofinfra.com
WORDPRESS_URL=https://admin.sofinfra.com

# Secret token for on-demand publish revalidation from WordPress
REVALIDATION_SECRET=sofinfra_publish_secret_2026
